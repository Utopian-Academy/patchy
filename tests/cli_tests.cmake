# Parsing failures must return usage exit 2 before COM/device access; no audio hardware needed.
function(reject expected)
  execute_process(COMMAND "${PATCHY_EXE}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
  if(NOT result STREQUAL "2")
    message(FATAL_ERROR "Expected usage exit 2, got ${result}: ${ARGN}\n${output}${error}")
  endif()
  string(FIND "${error}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing diagnostic '${expected}': ${ARGN}\n${error}")
  endif()
endfunction()
reject("numeric options require decimal digits" route --seconds nope)
reject("requires --to" monitor)
reject("option requires a value" monitor --map)
reject("numeric options require decimal digits" monitor --to unused --map "1,")
reject("numeric options require decimal digits" route --to unused --map "1,,2")
reject("numeric options require decimal digits" monitor --to unused --map "-1,1")
reject("outside its documented range" monitor --to unused --map "9,1")
reject("at most 8" route --to unused --map "1,1,1,1,1,1,1,1,1")
reject("duplicate option" monitor --to unused --map "1,1" --map "2,2")
reject("outside its documented range" monitor --to unused --queue-ms 0)
reject("outside its documented range" monitor --to unused --seconds 999999999999999999999999)
reject("unknown option" list --map "1,1")
